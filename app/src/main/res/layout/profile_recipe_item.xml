<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="15dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_light"
        android:minHeight="120dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_profile_recipe_item"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_recipe_book_logo" />

        <TextView
            android:id="@+id/tv_profile_recipe_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary_light"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_profile_recipe_edit"
            app:layout_constraintStart_toEndOf="@+id/iv_profile_recipe_item"
            app:layout_constraintTop_toTopOf="@+id/iv_profile_recipe_item"
            tools:text="Chicken Pasta" />

        <TextView
            android:id="@+id/tv_profile_recipe_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary_light"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_profile_recipe_edit"
            app:layout_constraintStart_toEndOf="@+id/iv_profile_recipe_item"
            app:layout_constraintTop_toBottomOf="@+id/tv_profile_recipe_title"
            tools:text="Easy homemade pasta recipe" />

        <ImageButton
            android:id="@+id/btn_profile_recipe_edit"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit recipe"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/round_edit_24"
            app:tint="@color/toast_success"
            app:layout_constraintEnd_toStartOf="@+id/btn_profile_recipe_delete"
            app:layout_constraintTop_toTopOf="@+id/iv_profile_recipe_item" />

        <ImageButton
            android:id="@+id/btn_profile_recipe_delete"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete recipe"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/baseline_delete_forever_24"
            app:tint="@color/toast_error"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_profile_recipe_item" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>